{
  "name": "app-generato",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "api:fetch": "node scripts/api-fetch.mjs",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "npm run api:generate && npm run typecheck",
    "lint": "eslint src tests --max-warnings 0",
    "lint:canary": "eslint canary --no-ignore",
    "test": "vitest run",
    "dev:be": "vite --mode be"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.3",
    "axios": "^1.7.9",
    "bootstrap-italia": "2.18.2",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "10.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "10.7.0",
    "eslint-plugin-boundaries": "7.1.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "msw": "2.15.0",
    "orval": "8.22.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
