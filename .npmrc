# engine-strict: `npm ci`/`npm install` FALLISCE (rc1) invece del solo warning EBADENGINE quando node
# non soddisfa `engines.node` di package.json. Quel floor (`^24.15.0 || >=26.0.0`) e' l'INTERSEZIONE
# di ">=24" (intento LTS del progetto) col vincolo transitivo di jsdom (`^22.22.2 || ^24.15.0 || >=26.0.0`):
# il progetto e' PIU' STRETTO di jsdom (esclude 22.x per policy LTS) e comunque 24.0-24.14 e 25.x sono
# ESCLUSI. Gate reale (giro 5 #4, giro 6/7 #8) per lo step2-codegen E per chi lancia npm fuori dalla
# skill. NB: l'errore npm nomina la DIPENDENZA che non combacia, non "node troppo vecchio".
engine-strict=true
