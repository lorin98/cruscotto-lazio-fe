{
  "components": {
    "schemas": {
      "Conteggio": {
        "description": "Numero intero, oppure null con il motivo dell'assenza",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (nessuna oggi: tutti i campi hanno una fonte acquisita)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA, NON_VALORIZZATO, ANNO_NON_CONSERVATO, FONTE_AMBIGUA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "Data": {
        "description": "Data, oppure null con il motivo dell'assenza",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (nessuna oggi: tutti i campi hanno una fonte acquisita)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA, NON_VALORIZZATO, ANNO_NON_CONSERVATO, FONTE_AMBIGUA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LocalDate"
              },
              {
                "type": "null"
              }
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "ImportoIstituzionale": {
        "description": "Importo al centesimo, oppure null con il motivo dell'assenza",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (nessuna oggi: tutti i campi hanno una fonte acquisita)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA, NON_VALORIZZATO, ANNO_NON_CONSERVATO, FONTE_AMBIGUA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "description": "Valore in euro, due decimali",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "ImportoUnitarioUnitAmount": {
        "properties": {
          "codiceUnitAmount": {
            "type": "string"
          },
          "esercizio": {
            "format": "int32",
            "type": "integer"
          },
          "gruppoColturale": {
            "type": "string"
          },
          "importoUnitario": {
            "$ref": "#/components/schemas/ImportoIstituzionale"
          }
        },
        "required": [
          "codiceUnitAmount",
          "gruppoColturale",
          "esercizio",
          "importoUnitario"
        ],
        "type": "object"
      },
      "LocalDate": {
        "examples": [
          "2022-03-10"
        ],
        "format": "date",
        "type": "string"
      },
      "MonitoraggioOutput": {
        "description": "TX-0017: output regionale programmato e realizzato per intervento e anno",
        "properties": {
          "annoFine": {
            "format": "int32",
            "type": "integer"
          },
          "annoInizio": {
            "format": "int32",
            "type": "integer"
          },
          "perimetro": {
            "description": "Sempre REGIONALE: i report istituzionali non hanno perimetro ADA",
            "enum": [
              "REGIONALE"
            ],
            "type": "string"
          },
          "realizzatoNonSigcCumulativo": {
            "description": "Il realizzato non SIGC e' il valore del file NOSIGC, cumulativo per anno di riferimento",
            "type": "boolean"
          },
          "righe": {
            "items": {
              "$ref": "#/components/schemas/MonitoraggioOutputRiga"
            },
            "type": "array"
          }
        },
        "required": [
          "annoInizio",
          "annoFine",
          "perimetro",
          "realizzatoNonSigcCumulativo",
          "righe"
        ],
        "type": "object"
      },
      "MonitoraggioOutputAnno": {
        "properties": {
          "anno": {
            "format": "int32",
            "type": "integer"
          },
          "programmato": {
            "$ref": "#/components/schemas/Quantita",
            "description": "Somma dell'output previsto delle Unit Amount dell'esercizio",
            "type": "object"
          },
          "realizzatoNonSigc": {
            "$ref": "#/components/schemas/Quantita",
            "description": "Output erogato non SIGC dell'anno di riferimento (valore del file, cumulativo)",
            "type": "object"
          },
          "realizzatoSigc": {
            "$ref": "#/components/schemas/Quantita",
            "description": "Output erogato SIGC dell'anno campagna",
            "type": "object"
          }
        },
        "required": [
          "anno",
          "programmato",
          "realizzatoSigc",
          "realizzatoNonSigc"
        ],
        "type": "object"
      },
      "MonitoraggioOutputRiga": {
        "properties": {
          "anni": {
            "description": "Tutti gli anni da annoInizio ad annoFine, in ordine",
            "items": {
              "$ref": "#/components/schemas/MonitoraggioOutputAnno"
            },
            "type": "array"
          },
          "annoTarget": {
            "description": "Anno del target, null se il target manca",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "codiceIntervento": {
            "type": "string"
          },
          "importiUnitari": {
            "items": {
              "$ref": "#/components/schemas/ImportoUnitarioUnitAmount"
            },
            "type": "array"
          },
          "indicatoreOutput": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetFinePeriodo": {
            "$ref": "#/components/schemas/Quantita",
            "description": "Target di fine periodo del CSR",
            "type": "object"
          },
          "unitaMisura": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "codiceIntervento",
          "indicatoreOutput",
          "unitaMisura",
          "targetFinePeriodo",
          "annoTarget",
          "anni",
          "importiUnitari"
        ],
        "type": "object"
      },
      "Problema": {
        "description": "Errore in formato problem+json (RFC 9457)",
        "properties": {
          "detail": {
            "description": "Dettaglio leggibile, senza dati personali: per 400, 404, 405, 409, 501, per il 429 (TROPPE_RICHIESTE) e per i 503 TEMPO_SCADUTO ed ESPORTAZIONE_NON_REGISTRATA; altrimenti assente (mai null)",
            "examples": [
              "campo anno: valore non ammesso"
            ],
            "type": "string"
          },
          "errorCode": {
            "description": "Codice stabile dell'errore, per esempio NON_AUTENTICATO, ACCESSO_NEGATO, RICHIESTA_NON_AMMESSA, DATO_NON_VALIDO, NOT_FOUND, METODO_NON_AMMESSO, VINCOLO_VIOLATO, TROPPE_RICHIESTE, TEMPO_SCADUTO: i codici di ciascuna operazione sono nelle descrizioni delle sue risposte",
            "examples": [
              "ACCESSO_NEGATO"
            ],
            "type": "string"
          },
          "status": {
            "description": "Status HTTP",
            "examples": [
              403
            ],
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "Frase di stato HTTP",
            "examples": [
              "Forbidden"
            ],
            "type": "string"
          },
          "type": {
            "description": "URI del tipo di errore, derivato da errorCode",
            "examples": [
              "urn:cruscottocsr:problem:accesso-negato"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errorCode"
        ],
        "type": "object"
      },
      "Quantita": {
        "description": "Quantita' di output nell'unita' di misura dell'indicatore, oppure null con il motivo",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (nessuna oggi: tutti i campi hanno una fonte acquisita)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA, NON_VALORIZZATO, ANNO_NON_CONSERVATO, FONTE_AMBIGUA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "SiNo": {
        "description": "Valore si'/no, oppure null con il motivo dell'assenza",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (nessuna oggi: tutti i campi hanno una fonte acquisita)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA, NON_VALORIZZATO, ANNO_NON_CONSERVATO, FONTE_AMBIGUA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "TestoIstituzionale": {
        "description": "Testo, oppure null con il motivo dell'assenza",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (nessuna oggi: tutti i campi hanno una fonte acquisita)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA, NON_VALORIZZATO, ANNO_NON_CONSERVATO, FONTE_AMBIGUA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "VerificaSmpNonSigc": {
        "description": "TX-0016: dati non SIGC dei file ASR per il confronto con SMP",
        "properties": {
          "annoRiferimento": {
            "description": "Anno di riferimento del monitoraggio SMP NOSIGC (output e avviso); null se nessun file presente",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "outputCumulativo": {
            "description": "L'output erogato e' il valore del file, cumulativo per anno di riferimento",
            "type": "boolean"
          },
          "perimetro": {
            "description": "Sempre REGIONALE: i report istituzionali non hanno perimetro ADA",
            "enum": [
              "REGIONALE"
            ],
            "type": "string"
          },
          "righe": {
            "items": {
              "$ref": "#/components/schemas/VerificaSmpNonSigcRiga"
            },
            "type": "array"
          }
        },
        "required": [
          "annoRiferimento",
          "perimetro",
          "outputCumulativo",
          "righe"
        ],
        "type": "object"
      },
      "VerificaSmpNonSigcRiga": {
        "properties": {
          "anticipiErogati": {
            "$ref": "#/components/schemas/ImportoIstituzionale"
          },
          "avvisiAttivati": {
            "$ref": "#/components/schemas/Conteggio"
          },
          "avvisiChiusi": {
            "$ref": "#/components/schemas/Conteggio"
          },
          "azioniAttivate": {
            "$ref": "#/components/schemas/Conteggio"
          },
          "chiusuraUltimoAvvisoAperto": {
            "$ref": "#/components/schemas/Data"
          },
          "codiceIntervento": {
            "type": "string"
          },
          "concessioniPreviste": {
            "$ref": "#/components/schemas/SiNo"
          },
          "domandeFinanziate": {
            "format": "int64",
            "type": "integer"
          },
          "domandeRicevute": {
            "format": "int64",
            "type": "integer"
          },
          "domandeRicevuteSenzaRichiesto": {
            "description": "Domande ricevute senza importo richiesto nella fonte, escluse dal valore",
            "format": "int64",
            "type": "integer"
          },
          "domandeSaldate": {
            "description": "Pratiche di sostegno con un pagamento di saldo (solo saldate al 100%)",
            "format": "int64",
            "type": "integer"
          },
          "dotazioneAvvisi": {
            "$ref": "#/components/schemas/ImportoIstituzionale"
          },
          "importoTopUp": {
            "$ref": "#/components/schemas/ImportoIstituzionale"
          },
          "includeTopUp": {
            "$ref": "#/components/schemas/SiNo"
          },
          "indicatoreOutput": {
            "$ref": "#/components/schemas/TestoIstituzionale"
          },
          "indicatoreRisultato": {
            "$ref": "#/components/schemas/TestoIstituzionale"
          },
          "outputAttesoFinanziate": {
            "$ref": "#/components/schemas/Quantita"
          },
          "outputErogato": {
            "$ref": "#/components/schemas/Quantita"
          },
          "spesaErogata": {
            "$ref": "#/components/schemas/ImportoIstituzionale",
            "description": "Spesa pubblica erogata, anticipi inclusi, al lordo dei recuperi",
            "type": "object"
          },
          "valoreDomandeFinanziate": {
            "$ref": "#/components/schemas/ImportoIstituzionale"
          },
          "valoreDomandeRicevute": {
            "$ref": "#/components/schemas/ImportoIstituzionale"
          }
        },
        "required": [
