          "indicatoreOutput",
          "indicatoreRisultato",
          "avvisiAttivati",
          "avvisiChiusi",
          "dotazioneAvvisi",
          "chiusuraUltimoAvvisoAperto",
          "domandeRicevute",
          "valoreDomandeRicevute",
          "domandeRicevuteSenzaRichiesto",
          "domandeFinanziate",
          "valoreDomandeFinanziate",
          "outputAttesoFinanziate",
          "domandeSaldate",
          "anticipiErogati",
          "spesaErogata",
          "outputErogato",
          "includeTopUp",
          "importoTopUp",
          "azioniAttivate",
          "concessioniPreviste"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "SecurityScheme": {
        "description": "Authentication",
        "openIdConnectUrl": "https://idp.example.invalid/realms/sian/.well-known/openid-configuration",
        "type": "openIdConnect"
      }
    }
  },
  "info": {
    "title": "ARSCSR-bootstrap-postgres API",
    "version": "1.0.0-SNAPSHOT"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/istituzionale/output-regionale": {
      "get": {
        "operationId": "TX-0017",
        "parameters": [
          {
            "description": "Id dell'azione portante (ripetibile, numerico)",
            "in": "query",
            "name": "azione",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Codice intervento (ripetibile); l'Assistenza tecnica AT001 non e' selezionabile",
            "in": "query",
            "name": "intervento",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Obiettivo generale, testo della gerarchia (ripetibile)",
            "in": "query",
            "name": "og",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Obiettivo di policy, testo della gerarchia (ripetibile)",
            "in": "query",
            "name": "op",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Codice dell'obiettivo specifico (ripetibile): seleziona gli interventi collegati, ognuno una volta",
            "in": "query",
            "name": "os",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitoraggioOutput"
                }
              }
            },
            "description": "Una riga per intervento selezionato, con tutti gli anni del periodo"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Filtri o anno non validi (DATO_NON_VALIDO)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Non autenticato"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Senza il grant della transazione; RICHIESTA_NON_AMMESSA se la richiesta non viene dall'applicazione: partita da un altro sito (Sec-Fetch-Site) oppure, per scritture ed export, senza X-Requested-With o da un'origine non ammessa"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Troppe richieste dello stesso utente in un minuto, o troppe autenticazioni con bearer fallite dallo stesso indirizzo (TROPPE_RICHIESTE): riprovare dopo i secondi di Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Da riprovare (header Retry-After): troppe letture di report in corso, in tutto o dello stesso utente (CAPACITA_ESAURITA), o lettura oltre il tetto di durata (TEMPO_SCADUTO)",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "SecurityScheme": [
              "csr.tx-0017.read"
            ]
          }
        ],
        "summary": "TX-0017: output regionale programmato e realizzato per intervento e anno",
        "tags": [
          "Istituzionale"
        ]
      }
    },
    "/api/istituzionale/verifica-smp-non-sigc": {
      "get": {
        "operationId": "TX-0016",
        "parameters": [
          {
            "description": "Anno di riferimento del monitoraggio SMP NOSIGC, 2000-2100; assente = l'ultimo anno con un file presente",
            "example": 2025,
            "in": "query",
            "name": "anno",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Id dell'azione portante (ripetibile, numerico)",
            "in": "query",
            "name": "azione",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Codice intervento (ripetibile); l'Assistenza tecnica AT001 non e' selezionabile",
            "in": "query",
            "name": "intervento",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Obiettivo generale, testo della gerarchia (ripetibile)",
            "in": "query",
            "name": "og",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Obiettivo di policy, testo della gerarchia (ripetibile)",
            "in": "query",
            "name": "op",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Codice dell'obiettivo specifico (ripetibile): seleziona gli interventi collegati, ognuno una volta",
            "in": "query",
            "name": "os",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificaSmpNonSigc"
                }
              }
            },
            "description": "Una riga per intervento selezionato"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Filtri o anno non validi (DATO_NON_VALIDO)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Non autenticato"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Senza il grant della transazione; RICHIESTA_NON_AMMESSA se la richiesta non viene dall'applicazione: partita da un altro sito (Sec-Fetch-Site) oppure, per scritture ed export, senza X-Requested-With o da un'origine non ammessa"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Troppe richieste dello stesso utente in un minuto, o troppe autenticazioni con bearer fallite dallo stesso indirizzo (TROPPE_RICHIESTE): riprovare dopo i secondi di Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
