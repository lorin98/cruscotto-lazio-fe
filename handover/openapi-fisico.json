{
  "components": {
    "schemas": {
      "DeterminaCorrente": {
        "description": "La determina piu' recente, oppure null con il motivo NON_VALORIZZATO se la domanda non ne ha",
        "properties": {
          "motivo": {
            "description": "NON_VALORIZZATO se la domanda non ha determine aperte, altrimenti null",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeterminaDellaDomanda"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "valore",
          "motivo"
        ],
        "type": "object"
      },
      "DeterminaDellaDomanda": {
        "properties": {
          "codice": {
            "description": "Codice della determina",
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/LocalDate",
            "description": "Data della determina",
            "type": "string"
          },
          "fonteComparto": {
            "description": "Il comparto della domanda viene da questa determina",
            "type": "boolean"
          },
          "fonteStatoAreaProgrammazione": {
            "description": "Lo stato della domanda nell'area programmazione viene da questa determina",
            "type": "boolean"
          }
        },
        "required": [
          "codice",
          "data",
          "fonteStatoAreaProgrammazione",
          "fonteComparto"
        ],
        "type": "object"
      },
      "DetermineDomanda": {
        "description": "TX-0020: codice e data delle determine da cui la domanda prende le informazioni",
        "properties": {
          "codiceABarre": {
            "description": "Codice a barre della domanda, sole cifre",
            "type": "string"
          },
          "corrente": {
            "$ref": "#/components/schemas/DeterminaCorrente"
          },
          "domandaChiusa": {
            "description": "La domanda non e' piu' nelle fonti SIAN (chiusa)",
            "type": "boolean"
          },
          "elenco": {
            "description": "Determine con riga aperta per la domanda, dalla piu' recente (data, poi codice)",
            "items": {
              "$ref": "#/components/schemas/DeterminaDellaDomanda"
            },
            "type": "array"
          },
          "tipoDomanda": {
            "description": "Tipo della domanda scelta: prima quella con determine agganciate (righe aperte), a parita' prima l'aperta e fra le aperte la PAGAMENTO",
            "enum": [
              "PAGAMENTO",
              "SOSTEGNO"
            ],
            "type": "string"
          }
        },
        "required": [
          "codiceABarre",
          "tipoDomanda",
          "domandaChiusa",
          "corrente",
          "elenco"
        ],
        "type": "object"
      },
      "LocalDate": {
        "examples": [
          "2022-03-10"
        ],
        "format": "date",
        "type": "string"
      },
      "Problema": {
        "description": "Errore in formato problem+json (RFC 9457)",
        "properties": {
          "detail": {
            "description": "Dettaglio leggibile, senza dati personali: per 400, 404, 405, 409, 501, per il 429 (TROPPE_RICHIESTE) e per i 503 TEMPO_SCADUTO ed ESPORTAZIONE_NON_REGISTRATA; altrimenti assente (mai null)",
            "examples": [
              "campo anno: valore non ammesso"
            ],
            "type": "string"
          },
          "errorCode": {
            "description": "Codice stabile dell'errore, per esempio NON_AUTENTICATO, ACCESSO_NEGATO, RICHIESTA_NON_AMMESSA, DATO_NON_VALIDO, NOT_FOUND, METODO_NON_AMMESSO, VINCOLO_VIOLATO, TROPPE_RICHIESTE, TEMPO_SCADUTO: i codici di ciascuna operazione sono nelle descrizioni delle sue risposte",
            "examples": [
              "ACCESSO_NEGATO"
            ],
            "type": "string"
          },
          "status": {
            "description": "Status HTTP",
            "examples": [
              403
            ],
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "Frase di stato HTTP",
            "examples": [
              "Forbidden"
            ],
            "type": "string"
          },
          "type": {
            "description": "URI del tipo di errore, derivato da errorCode",
            "examples": [
              "urn:cruscottocsr:problem:accesso-negato"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errorCode"
        ],
        "type": "object"
      },
      "QuantitaRichiestaPremio": {
        "description": "Quantita' richiesta a premio (ASR2-08), oppure null con il motivo dell'assenza",
        "properties": {
          "fonte": {
            "description": "Fonte attesa, solo con FONTE_NON_ATTIVA (QUANTITA_RICHIESTA_PREMIO)",
            "type": [
              "string",
              "null"
            ]
          },
          "motivo": {
            "description": "Motivo dell'assenza, null se c'e' il valore: FONTE_NON_ATTIVA",
            "type": [
              "string",
              "null"
            ]
          },
          "valore": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "valore",
          "motivo",
          "fonte"
        ],
        "type": "object"
      },
      "SuperficieAmmissibile": {
        "description": "TX-0018: superficie ammissibile della domanda di sostegno e della domanda di pagamento per intervento e campagna",
        "properties": {
          "campagna": {
            "description": "Campagna richiesta; null = tutte le campagne presenti",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "perimetro": {
            "description": "Sempre REGIONALE: le letture dell'area fisica non hanno perimetro ADA",
            "enum": [
              "REGIONALE"
            ],
            "type": "string"
          },
          "righe": {
            "items": {
              "$ref": "#/components/schemas/SuperficieIntervento"
            },
            "type": "array"
          }
        },
        "required": [
          "campagna",
          "perimetro",
          "righe"
        ],
        "type": "object"
      },
      "SuperficieCampagna": {
        "properties": {
          "anno": {
            "description": "Anno di campagna",
            "format": "int32",
            "type": "integer"
          },
          "differenzaDpDs": {
            "description": "Superficie DP meno superficie DS, negativa se la DP e' minore. Ettari, due decimali",
            "type": "number"
          },
          "domandeDpOltreDs": {
            "description": "Domande di pagamento con superficie DP maggiore della loro DS",
            "format": "int64",
            "type": "integer"
          },
          "domandePagamento": {
            "description": "Domande di pagamento contate",
            "format": "int64",
            "type": "integer"
          },
          "domandeSostegno": {
            "description": "Domande di sostegno contate (la superficie DS si conta una volta per domanda di sostegno)",
            "format": "int64",
            "type": "integer"
          },
          "quantitaRichiestaPremio": {
            "$ref": "#/components/schemas/QuantitaRichiestaPremio"
          },
          "sostegniDiscordanti": {
            "description": "Domande di sostegno riportate con superfici DS diverse: si e' preso il massimo",
            "format": "int64",
            "type": "integer"
          },
          "superficieDp": {
            "description": "Superficie ammissibile della domanda di pagamento. Ettari, due decimali",
            "type": "number"
          },
          "superficieDs": {
            "description": "Superficie ammissibile della domanda di sostegno. Ettari, due decimali",
            "type": "number"
          }
        },
        "required": [
          "anno",
          "domandePagamento",
          "domandeSostegno",
          "sostegniDiscordanti",
          "superficieDs",
          "superficieDp",
          "differenzaDpDs",
          "domandeDpOltreDs",
          "quantitaRichiestaPremio"
        ],
        "type": "object"
      },
      "SuperficieIntervento": {
        "properties": {
          "campagne": {
            "description": "Campagne con domande, in ordine crescente",
            "items": {
              "$ref": "#/components/schemas/SuperficieCampagna"
            },
            "type": "array"
          },
          "codiceIntervento": {
            "type": "string"
          },
          "motivo": {
            "description": "NON_VALORIZZATO se l'intervento non ha superfici in nessuna campagna, altrimenti null",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "codiceIntervento",
          "motivo",
          "campagne"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "SecurityScheme": {
        "description": "Authentication",
        "openIdConnectUrl": "https://idp.example.invalid/realms/sian/.well-known/openid-configuration",
        "type": "openIdConnect"
      }
    }
  },
  "info": {
    "title": "ARSCSR-bootstrap-postgres API",
    "version": "1.0.0-SNAPSHOT"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/fisico/domande/{codice}/determina": {
      "get": {
        "operationId": "TX-0020",
        "parameters": [
          {
            "description": "Codice a barre della domanda, sole cifre (al piu' 30)",
            "example": "54810769585",
            "in": "path",
            "name": "codice",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetermineDomanda"
                }
              }
            },
            "description": "La determina corrente e le determine con riga aperta"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Criteri non validi (DATO_NON_VALIDO)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Non autenticato"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Senza il grant della transazione; RICHIESTA_NON_AMMESSA se la richiesta non viene dall'applicazione: partita da un altro sito (Sec-Fetch-Site) oppure, per scritture ed export, senza X-Requested-With o da un'origine non ammessa"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Nessuna domanda con quel codice a barre (NOT_FOUND)"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Troppe richieste dello stesso utente in un minuto, o troppe autenticazioni con bearer fallite dallo stesso indirizzo (TROPPE_RICHIESTE): riprovare dopo i secondi di Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Da riprovare (header Retry-After): troppe letture di report in corso, in tutto o dello stesso utente (CAPACITA_ESAURITA), o lettura oltre il tetto di durata (TEMPO_SCADUTO)",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "SecurityScheme": [
              "csr.tx-0020.read"
            ]
          }
        ],
        "summary": "TX-0020: codice e data delle determine da cui la domanda prende le informazioni",
        "tags": [
          "Fisico"
        ]
      }
    },
    "/api/fisico/superficie-ammissibile": {
      "get": {
        "operationId": "TX-0018",
        "parameters": [
          {
            "description": "Id dell'azione portante (ripetibile, numerico)",
            "in": "query",
            "name": "azione",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Anno di campagna, 2000-2100; assente = tutte le campagne presenti",
            "example": 2025,
            "in": "query",
            "name": "campagna",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Codice intervento (ripetibile); l'Assistenza tecnica AT001 non e' selezionabile",
            "in": "query",
            "name": "intervento",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Obiettivo generale, testo della gerarchia (ripetibile)",
            "in": "query",
            "name": "og",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Obiettivo di policy, testo della gerarchia (ripetibile)",
            "in": "query",
            "name": "op",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Codice dell'obiettivo specifico (ripetibile): seleziona gli interventi collegati, ognuno una volta",
            "in": "query",
            "name": "os",
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuperficieAmmissibile"
                }
              }
            },
            "description": "Una riga per intervento selezionato"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Criteri non validi (DATO_NON_VALIDO)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Non autenticato"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Senza il grant della transazione; RICHIESTA_NON_AMMESSA se la richiesta non viene dall'applicazione: partita da un altro sito (Sec-Fetch-Site) oppure, per scritture ed export, senza X-Requested-With o da un'origine non ammessa"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Troppe richieste dello stesso utente in un minuto, o troppe autenticazioni con bearer fallite dallo stesso indirizzo (TROPPE_RICHIESTE): riprovare dopo i secondi di Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Da riprovare (header Retry-After): troppe letture di report in corso, in tutto o dello stesso utente (CAPACITA_ESAURITA), o lettura oltre il tetto di durata (TEMPO_SCADUTO)",
            "headers": {
              "Retry-After": {
                "description": "Secondi da attendere prima di riprovare",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "SecurityScheme": [
              "csr.tx-0018.read"
            ]
          }
        ],
        "summary": "TX-0018: superficie ammissibile DS e DP per intervento e campagna, con il confronto",
        "tags": [
          "Fisico"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Auto generated value",
      "url": "http://localhost:8080"
    },
    {
      "description": "Auto generated value",
      "url": "http://0.0.0.0:8080"
    }
  ],
  "tags": [
    {
      "description": "Letture dell'area fisica (TX-0018, TX-0020)",
      "name": "Fisico"
    }
  ]
}
